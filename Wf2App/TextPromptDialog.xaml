<Window x:Class="Wf2App.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Padding="4,3" TextChanged="Input_TextChanged" />
        <TextBlock x:Name="Error" Foreground="{StaticResource Crit}" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,4" MinWidth="80" />
            <Button x:Name="OkButton" Content="OK" Click="Ok_Click" IsDefault="True"
                    Padding="14,4" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
