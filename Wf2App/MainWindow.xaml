<Window x:Class="Wf2App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wf2App"
        mc:Ignorable="d"
        Title="Wreckfest 2 Tuning" Height="620" Width="960"
        Icon="appicon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource AppFontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Settings…" Click="Settings_Click"
                        Padding="12,4" MinWidth="80" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Left" Content="Open…" Command="{Binding OpenCommand}" Padding="12,4" MinWidth="70" />
                <Button DockPanel.Dock="Left" Content="Reload" Command="{Binding ReloadCommand}" Padding="12,4" MinWidth="70" Margin="6,0,0,0" />
                <TextBlock Text="{Binding SavePath}" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,5" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Margin="12,0,0,0"
                           FontFamily="Consolas" FontSize="11"
                           Text="{Binding BackupDir, StringFormat='Backups: {0}'}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupDir}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Cars / presets tree -->
            <TreeView x:Name="Tree" Grid.Column="0" BorderThickness="0" Padding="6"
                      Background="{StaticResource Tree}" Foreground="{StaticResource Ink}"
                      ItemsSource="{Binding Cars}"
                      SelectedItemChanged="Tree_SelectedItemChanged">
                <TreeView.Resources>
                    <!-- Cars only. Presets are chosen in the car pane on the right, so the tree
                         does not expand into them (that duplication was redundant). -->
                    <DataTemplate DataType="{x:Type local:CarVm}">
                        <StackPanel>
                            <Border Height="1" Background="{StaticResource Line}" Margin="-20,5,4,5"
                                    Visibility="{Binding HasDividerAbove, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Config, StringFormat=' [{0}]'}" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="{StaticResource Line}" />

            <!-- Detail: selected preset's values -->
            <Grid Grid.Column="2" Background="{StaticResource Bg}" Margin="14,12">
                <!-- First run: no profile loaded -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowNoSave, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No profile loaded" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Open your Wreckfest 2 profile.sgfi to get started."
                               Foreground="{StaticResource Muted}" Margin="0,4,0,12" HorizontalAlignment="Center" />
                    <Button Content="Open…" Command="{Binding OpenCommand}" Style="{StaticResource AccentButton}"
                            Padding="16,6" MinWidth="110" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Save loaded, nothing selected -->
                <TextBlock Text="Select a car to see its presets."
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}" />

                <!-- Car selected (no preset): summary, its presets, and create a new preset -->
                <DockPanel Visibility="{Binding ShowCar, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCar.Name}" FontSize="19" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding SelectedCar.Config}" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding SelectedCar.Presets.Count, StringFormat=' · {0} preset(s)'}"
                                           Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Import…" Click="ImportNew_Click" Padding="12,5" MinWidth="80" />
                            <Button Content="New preset…" Click="NewPreset_Click" Style="{StaticResource AccentButton}"
                                    Padding="14,5" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="PRESETS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Muted}" Margin="0,0,0,4" />

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                            Background="{StaticResource Tree}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedCar.Presets}" Margin="3">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PresetVm}">
                                        <Button Style="{StaticResource RowButton}" Click="PresetRow_Click"
                                                ToolTip="View this preset's tuning — right-click for more">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                                   RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Export…" Click="PresetExport_Click" />
                                                    <MenuItem Header="Rename…" Click="PresetRename_Click" />
                                                    <Separator />
                                                    <MenuItem Header="Delete…" Click="PresetDelete_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="●" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Foreground="{StaticResource Accent}" ToolTip="Selected in-game"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <DockPanel Visibility="{Binding HasSelectedPreset, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel>
                                <Button Click="Back_Click" Style="{StaticResource BackButton}" Margin="0,0,0,8"
                                        ToolTip="Back to this car's presets"
                                        Content="{Binding SelectedCar.Name, StringFormat='←  Back to {0}'}" />
                                <TextBlock Text="{Binding SelectedPreset.Name}" FontSize="19" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedCar.Name}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding SelectedPreset.ValueCount, StringFormat=' · {0} stored value(s)'}"
                                               Foreground="{StaticResource Muted}" />
                                    <TextBlock Text=" · selected in-game" Foreground="{StaticResource Accent}"
                                               Visibility="{Binding SelectedPreset.IsActive, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- View-mode actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding ViewingPreset, Converter={StaticResource BoolToVis}}">
                                <Button Content="Edit" Click="Edit_Click" Style="{StaticResource AccentButton}"
                                        Padding="14,4" MinWidth="70" IsEnabled="{Binding CanEdit}"
                                        ToolTip="Adjust this preset's values with sliders" />
                                <Button Content="Duplicate…" Click="Duplicate_Click" Padding="12,4" MinWidth="90" Margin="6,0,0,0" />
                                <Button Content="Export…" Click="Export_Click" Padding="12,4" MinWidth="80" Margin="6,0,0,0" />
                            </StackPanel>

                            <!-- Edit-mode actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding EditingPreset, Converter={StaticResource BoolToVis}}">
                                <Button Content="Discard" Click="DiscardEdit_Click" Padding="12,4" MinWidth="80" />
                                <Button Content="Save changes" Click="SaveEdits_Click" Style="{StaticResource AccentButton}"
                                        Padding="14,4" MinWidth="110" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <!-- 'all default' hint, shown only when the preset is empty -->
                        <TextBlock Text="This preset stores nothing — every slider is at its default."
                                   Foreground="{StaticResource Warn}" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset.HasValues}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Grid>
                        <!-- Read-only value grid -->
                        <DataGrid ItemsSource="{Binding SelectedPreset.Values}"
                                  Visibility="{Binding ViewingPreset, Converter={StaticResource BoolToVis}}"
                                  Background="{StaticResource Bg}" RowBackground="Transparent"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0" CanUserReorderColumns="False"
                                  CanUserResizeRows="False" SelectionMode="Single">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <!-- Unmapped parameters shown muted -->
                                        <DataTrigger Binding="{Binding IsMapped}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding IndexLabel}" Width="52"
                                                    ElementStyle="{StaticResource IndexCell}" />
                                <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Display}" Width="*"
                                                    ElementStyle="{StaticResource ValueCell}"
                                                    HeaderStyle="{StaticResource NumHeader}" />
                                <DataGridTextColumn Header="Stored (SI)" Binding="{Binding Raw}" Width="*"
                                                    ElementStyle="{StaticResource MutedCell}"
                                                    HeaderStyle="{StaticResource NumHeader}" />
                                <DataGridTextColumn Header="aux" Binding="{Binding Aux}" Width="64"
                                                    ElementStyle="{StaticResource MutedCell}"
                                                    HeaderStyle="{StaticResource NumHeader}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Slider editor -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding EditingPreset, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Editables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:EditableValueVm}">
                                        <Grid Margin="0,5" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                            <!-- editable: slider with end labels -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center"
                                                  Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MinLabel}" Foreground="{StaticResource Muted}"
                                                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="{Binding SliderMax}"
                                                        Value="{Binding Aux, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding MaxLabel}" Foreground="{StaticResource Muted}"
                                                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                            <!-- read-only: not-yet-editable note -->
                                            <TextBlock Grid.Column="1" Text="read-only (car-specific range)" FontStyle="Italic"
                                                       Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Grid.Column="2" Text="{Binding Display}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
