{
  "name": "@wreckfest/tuning-presets",
  "version": "0.1.0",
  "description": "Construct importable Wreckfest 2 tuning presets (.json) for the Wreckfest 2 Tuning Editor.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "schema/wf2-schema.json"],
  "sideEffects": false,
  "scripts": {
    "gen": "node scripts/gen-schema.mjs",
    "build": "npm run gen && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
